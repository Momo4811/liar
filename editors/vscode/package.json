{
  "name": "liar",
  "displayName": "liar",
  "description": "Finds Python code that says one thing and does another",
  "version": "0.1.0",
  "publisher": "Momo4811",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "homepage": "https://github.com/Momo4811/liar#readme",
  "bugs": {
    "url": "https://github.com/Momo4811/liar/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Momo4811/liar"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "linter",
    "static analysis",
    "async"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "liar",
      "properties": {
        "liar.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run liar on Python files."
        },
        "liar.tone": {
          "type": "string",
          "enum": [
            "professional",
            "dry",
            "brutal"
          ],
          "enumDescriptions": [
            "Usable at work without explaining yourself.",
            "Deadpan and specific.",
            "Blunter. Still true."
          ],
          "default": "dry",
          "description": "How findings are worded."
        },
        "liar.path": {
          "type": "string",
          "default": "",
          "description": "Path to the liar-lsp binary. Leave empty to find it on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "liar.restart",
        "title": "liar: Restart language server"
      }
    ]
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=out/extension.js --sourcemap",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "npm run check && npm run compile -- --minify",
    "package": "vsce package --no-dependencies",
    "test": "npm run compile && node ./test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
